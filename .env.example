# Copia este archivo a .env y llénalo (el .env NUNCA se sube a Git).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
GOLD_ARTIFACTS_PATH=/Volumes/workspace/g6_oro/artifacts
BRONZE_LOGS_PATH=/Volumes/workspace/g6_bronce/crudos/api_logs
ARTIFACTS_DIR=
IMAGEN_DOCKER=
# Opcionales:
# ENTORNO=local          (deploy.sh pone "servidor" en el droplet; separa los logs en el monitoreo)
# APP_UID=1000           (deploy.sh los llena con el usuario del servidor para que Docker
# APP_GID=1000            pueda escribir en logs/ y artifacts/)
