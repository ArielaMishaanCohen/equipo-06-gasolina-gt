# Copia este archivo a .env (en la raíz del repo) y llénalo. El .env NUNCA se sube a Git.
# En el Droplet: chmod 600 .env

# --- Puerto de la API (80XX del equipo) ---
PUERTO=8006

# --- Capa Oro en S3 (lo que pide el enunciado): credenciales de SOLO LECTURA ---
ORO_S3_PREFIX=s3://cc3105-au-869227452861-us-east-2-an/equipo6/gold
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# --- Plan B: leer Oro vía SQL warehouse de Databricks (si no hay credenciales de AWS) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# --- Subida de logs de consultas a Bronce (gasolina-sync subir-logs) ---
BRONZE_LOGS_PATH=/Volumes/workspace/g6_bronce/crudos/api_logs

# --- Opcionales ---
# ENTORNO=local           (deploy.sh pone "servidor" en el Droplet)
# IMAGEN_DOCKER=ghcr.io/arielamishaancohen/gasolina-mlops:latest   (solo modo Docker)
# APP_UID=1000 / APP_GID=1000   (deploy.sh los llena en modo Docker)
